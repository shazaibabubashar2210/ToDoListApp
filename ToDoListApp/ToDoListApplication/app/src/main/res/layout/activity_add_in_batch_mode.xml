<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#003366">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="@color/bluebackground"
        android:gravity="center_vertical">

        <!-- Back Arrow -->
        <ImageView
            android:id="@+id/back_arrow"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/baseline_arrow_back_24"
            android:contentDescription="Back Arrow"
            />

        <!-- Header Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add in Batch Mode"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginStart="16dp" />
    </LinearLayout>

    <!-- Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Task Input -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="What is to be done?"
                android:textColor="@color/white"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/task_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Task 1\nTask 2\nTask 3"
                android:textColorHint="@color/gray"
                android:textColor="#FFFFFF"
                android:gravity="top|start"
                android:padding="8dp"
                android:layout_marginTop="8dp"
                android:inputType="textMultiLine"
                android:lines="5" />

            <!-- Due Date -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Due Date"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:layout_marginTop="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/due_date_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Date not set"
                    android:textColor="#FFFFFF" />

                <ImageView
                    android:id="@+id/due_date_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_calander"
                    android:contentDescription="Set Date"
                     />
            </LinearLayout>

            <!-- Notifications -->
            <TextView
                android:id="@+id/notification_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No notifications if date not set."
                android:textColor="#CCCCCC"
                android:textSize="12sp"
                android:layout_marginTop="8dp" />

            <!-- Add to List -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Add to List"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:layout_marginTop="16dp" />

            <Spinner
                android:id="@+id/list_spinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#002244"
                android:padding="8dp"
                android:layout_marginTop="8dp" />

            <!-- Submit Button -->
            <ImageView
                android:id="@+id/submit_button"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:src="@drawable/baseline_check_24"
                android:background="@drawable/circle_background"
                android:contentDescription="Submit"
                android:padding="16dp"
                android:layout_gravity="end"
                android:layout_marginTop="16dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
