        <item name="android:textColor">#FFFFFF</item>
    </style>
    <!-- Spinner item style -->
    <style name="CustomSpinnerStyle" parent="Theme.AppCompat.Light">
        <item name="android:popupBackground">@android:color/white</item> <!-- White background for dropdown -->
