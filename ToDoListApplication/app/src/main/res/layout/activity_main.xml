<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blue_background">

    <!-- Top Bar -->
    <RelativeLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#005599">

        <!-- Check Icon -->
        <ImageView
            android:id="@+id/check"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_centerVertical="true"
            android:layout_marginStart="16dp"
            android:layout_alignParentStart="true"
            android:src="@drawable/baseline_check_circle_outline_24" />

        <!-- Title Text -->
        <TextView
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@id/check"
            android:layout_marginStart="8dp"
            android:text="All Lists"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Search Icon -->
        <ImageView
            android:id="@+id/searchIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="56dp"
            android:src="@drawable/search" />

        <!-- Menu Icon -->
        <ImageView
            android:id="@+id/menuIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="16dp"
            android:src="@drawable/more" />
    </RelativeLayout>

    <!-- Icon and Text -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        android:gravity="center">

        <ImageView
            android:id="@+id/hammockIcon"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/hammock" />

        <TextView
            android:id="@+id/nothingToDoText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Nothing to do"
            android:textColor="@color/gray"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Floating Action Button -->

    <!-- Bottom Input Bar -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="23dp"
        android:layout_marginBottom="93dp"
        android:contentDescription="Add a new task"
        android:src="@drawable/baseline_add_24"
        android:background="@drawable/circle_background"

        />


    <EditText
        android:id="@+id/quickTaskInput"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentEnd="true"
        android:backgroundTint="#005599"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="1dp"
        android:background="@android:drawable/edit_text"
        android:drawableStart="@drawable/microphone"
        android:drawablePadding="8dp"
        android:hint="Enter Quick Task Here"
        android:paddingStart="10dp"
        android:paddingEnd="16dp"
        android:textColor="#FFFFFF"
        android:textColorHint="#B0BEC5" />
</RelativeLayout>
